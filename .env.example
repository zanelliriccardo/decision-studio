DATABASE_URL=postgresql+asyncpg://decision_studio:decision_studio@localhost:5432/decision_studio
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
BRAVE_SEARCH_API_KEY=BSA...
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o
LLM_PROVIDER=openai
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# --- Intake questions -------------------------------------------------------
# Deployment-wide off switch, independent of the per-browser preference. With
# this false the questions endpoint returns an empty list without calling a
# model, and the client forwards straight to the analysis — so the feature can
# be turned off on a running deployment without rebuilding the frontend.
INTAKE_ENABLED=true
# Ceiling on the rendered answers. This string is prepended to *every* inference
# prompt and a run evaluates hundreds of pairs, so the cost is roughly
# `chars/4 x pairs` extra input tokens — weigh that product, not one answer.
INTAKE_CONTEXT_MAX_CHARS=6000
# Hard cap on questions. Four is a ceiling, not a target.
INTAKE_MAX_QUESTIONS=4
